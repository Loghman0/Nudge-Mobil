{
  "name": "nudge-mobile",
  "version": "0.9.4",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "sync:core": "node scripts/sync-core.mjs",
    "check:core": "node scripts/sync-core.mjs --check",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "export:android": "expo export --platform android --output-dir dist/bundle"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "2.110.7",
    "expo": "58.0.23",
    "expo-audio": "~58.0.11",
    "expo-crypto": "58.0.7",
    "expo-file-system": "58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-notifications": "58.1.8",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.22",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "expo-web-browser": "58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-url-polyfill": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "~19.3.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
