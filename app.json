{
  "expo": {
    "name": "Nudge",
    "slug": "nudge-mobile",
    "version": "0.9.4",
    "scheme": "com.projectnudge.app",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#edf2f7"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "./plugins/with-short-cmake-paths.js",
      "./plugins/with-opening-background.js",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "./plugins/with-native-notices.js",
      [
        "expo-notifications",
        {
          "defaultChannel": "checkins",
          "icon": "./assets/notification-icon.png",
          "color": "#355db9"
        }
      ],
      "./plugins/with-push-consent.js",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "android": {
      "package": "com.projectnudge.app",
      "versionCode": 14,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#edf2f7"
      },
      "allowBackup": false,
      "googleServicesFile": "./google-services.json"
    }
  }
}
